const fs = require("fs");
const path = require("path");

// Chemins vers la racine du projet (au-dessus de src/utils/)
const DB_PATH = path.join(__dirname, "../../daily-stats-db.json");
const HISTORY_PATH = path.join(__dirname, "../../stats-history.json");

function loadStats() {
  try {
    if (fs.existsSync(DB_PATH)) {
      return JSON.parse(fs.readFileSync(DB_PATH, "utf8"));
    }
  } catch (err) {
    console.error("Error loading daily stats DB:", err);
  }
  return {};
}

function saveStats(data) {
  try {
    fs.writeFileSync(DB_PATH, JSON.stringify(data, null, 2), "utf8");
  } catch (err) {
    console.error("Error saving daily stats DB:", err);
  }
}

function loadHistory() {
  try {
    if (fs.existsSync(HISTORY_PATH)) {
      return JSON.parse(fs.readFileSync(HISTORY_PATH, "utf8"));
    }
  } catch (err) {
    console.error("Error loading stats history:", err);
  }
  return [];
}

function saveHistory(historyData) {
  try {
    fs.writeFileSync(HISTORY_PATH, JSON.stringify(historyData, null, 2), "utf8");
  } catch (err) {
    console.error("Error saving stats history:", err);
  }
}

function createDailyStatsStore() {
  const statsData = loadStats();

  return {
    registerSuccess(secretName, tryCount = 1, hintUses = 0, timeInSeconds = 0) {
      const today = new Date().toLocaleDateString("sv-SE", {
        timeZone: "Europe/Paris",
      });
      const key = `${today}_${secretName}`;

      if (!statsData[key]) {
        statsData[key] = {
          count: 0,
          totalTries: 0,
          totalHints: 0,
          totalTime: 0,
        };
      }

      statsData[key].count += 1;
      statsData[key].totalTries += Number(tryCount) || 1;
      statsData[key].totalHints += Number(hintUses) || 0;
      statsData[key].totalTime += Number(timeInSeconds) || 0;

      saveStats(statsData);
      return statsData[key];
    },

    getStats(secretName) {
      const today = new Date().toLocaleDateString("sv-SE", {
        timeZone: "Europe/Paris",
      });
      const key = `${today}_${secretName}`;
      const entry = statsData[key];

      if (!entry || entry.count === 0) {
        return { count: 0, avgTries: 0, avgHints: 0, avgTime: 0 };
      }

      return {
        count: entry.count,
        avgTries: Number((entry.totalTries / entry.count).toFixed(1)),
        avgHints: Number((entry.totalHints / entry.count).toFixed(1)),
        avgTime: Math.round(entry.totalTime / entry.count),
      };
    },

    archiveCurrentStats(secretName) {
      if (!secretName) return null;

      const today = new Date().toLocaleDateString("sv-SE", {
        timeZone: "Europe/Paris",
      });
      const key = `${today}_${secretName}`;
      const entry = statsData[key];

      const currentHistory = loadHistory();

      const archivedRecord = {
        date: today,
        secretWord: secretName,
        victories: entry ? entry.count : 0,
        avgTries: entry && entry.count > 0 ? Number((entry.totalTries / entry.count).toFixed(1)) : 0,
        avgHints: entry && entry.count > 0 ? Number((entry.totalHints / entry.count).toFixed(1)) : 0,
        avgTimeInSeconds: entry && entry.count > 0 ? Math.round(entry.totalTime / entry.count) : 0,
        archivedAt: new Date().toISOString(),
      };

      currentHistory.push(archivedRecord);
      saveHistory(currentHistory);

      return archivedRecord;
    },
  };
}

module.exports = { createDailyStatsStore };